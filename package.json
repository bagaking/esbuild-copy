    "paste"
  ],
  "author": "bagaking <kinghand@foxmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bagaking/esbuild-copy/issues"
  },
  "homepage": "https://github.com/bagaking/esbuild-copy#readme",
  "devDependencies": {
    "@types/node": "^18.11.17",
    "esbuild": "^0.25.12"
  }
}
